# ─── обязательно ─────────────────────────────────────────────────────────
# Токен бота от @BotFather
TG_TOKEN=

# ─── мозг ────────────────────────────────────────────────────────────────
# zai   — облако Z.ai (быстро, нужен ZAI_API_KEY)
# local — локальный llama-server в контейнере (медленнее, но без облака)
BRAIN=zai

# Ключ Z.ai. Бесплатна только glm-4.5-flash.
ZAI_API_KEY=
ZAI_MODEL=glm-4.5-flash

# ─── персонаж ────────────────────────────────────────────────────────────
# Имя бота без @ — по нему он понимает упоминания в группе
BOT_USERNAME=
# Слова, на которые откликается и без упоминания (через запятую)
KEYWORDS=петрович,алкаш
# Часовой пояс для подстановки даты в промпт
TZ_OFFSET=2

# Люди из чата, которых персонаж знает по имени (через запятую).
# Оставьте пустым — тогда он просто никого не выделяет.
# В репозитории этот список намеренно пуст: чужие ники сюда не попадают.
KNOWN_PEOPLE=

# ─── антиспам ────────────────────────────────────────────────────────────
# Фраза, которой отвечает на рекламу от других ботов
SPAM_REPLY=ненавижу эту ебучую рекламу
# Не чаще одного ответа на чат за столько секунд
SPAM_COOLDOWN=60

# ─── локальные модели (для BRAIN=local и для антиспама) ──────────────────
# Имена файлов в ./models
LOCAL_MODEL_FILE=Qwen3-4B-Instruct-2507-Q4_K_M.gguf
CLASSIFIER_MODEL_FILE=Qwen3-4B-Instruct-2507-Q4_K_M.gguf
CTX=4096
THREADS=4
